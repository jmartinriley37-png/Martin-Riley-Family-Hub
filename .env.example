# Documentation only: server.py reads process environment, not .env files.
HUB_DB=/var/lib/martin-riley/hub.sqlite3
HUB_HOST=127.0.0.1
PORT=8080
HUB_ORIGIN=https://family.example.com
HUB_SECURE_COOKIE=1

# Build D persistence (placeholders only; never commit real values).
# HUB_ENV=production                 # production requires HUB_DB_BACKEND and verified TLS
# HUB_DB_BACKEND=sqlite              # sqlite (default in development) or postgres
# HUB_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME              # runtime role
# HUB_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME    # migration/import tool only
# HUB_DB_SSLMODE=verify-full         # production default; HUB_DB_SSLROOTCERT=/path/to/ca.pem if needed
# HUB_DB_POOL_MIN=1
# HUB_DB_POOL_MAX=5
# HUB_DB_POOL_TIMEOUT=5
# HUB_DB_CONNECT_TIMEOUT=5
# HUB_TEST_POSTGRES_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DISPOSABLE_TEST_DB   # tests only
